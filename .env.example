# Sonda environment (docker-compose.yml). On Coolify these appear under
# Environment Variables once the compose file is loaded; locally, copy to .env.
# Never commit real values.

# --- Required ---------------------------------------------------------------

# Secret for the MCP endpoint /mcp/sonda (A4). At least 32 characters:
#   openssl rand -hex 32
SONDA_MCP_TOKEN=

# Cloudflare R2 (Litestream replica, D4). From R2 > Manage API tokens:
# an "Object Read & Write" token limited to the bucket below.
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=sonda-backup
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Optional (defaults shown) ------------------------------------------------

# Key prefix inside the bucket; change it to keep a second copy apart.
R2_PATH=sonda
# R2 wants "auto"; other S3 providers their region.
R2_REGION=auto
# true for MinIO and other path-style-only stores; R2 works with false.
R2_FORCE_PATH_STYLE=false

# Ingest limits (A2).
SONDA_INGEST_RATE_PER_MIN=60
SONDA_INGEST_MAX_BATCH=100
SONDA_INGEST_MAX_BODY_BYTES=262144
# Events stored per app per UTC day; past it, 429 until midnight UTC (O6 S1).
SONDA_INGEST_DAILY_QUOTA=50000

# Printed by `sonda version` and in the startup log (build argument).
SONDA_VERSION=dev
